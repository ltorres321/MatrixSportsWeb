# Supabase project settings > API. The URL is derived from the same
# project as SportsWeb's DATABASE_URL (db.<ref>.supabase.co -> the API
# lives at https://<ref>.supabase.co). Use the "Publishable key" from
# the "Publishable and secret API keys" tab (starts with
# sb_publishable_) -- safe to expose to the browser. NOT the "Secret
# key" (sb_secret_..., the modern name for what used to be called
# service_role) -- that one must never leave the server.
NEXT_PUBLIC_SUPABASE_URL=https://wbhfemmudiiwlgldrzjk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection -- same value as the root SportsWeb/.env
# and SportsAnalytics/.env use, same database. Server-only: read via
# src/lib/db.ts, never NEXT_PUBLIC_, never imported from a "use client"
# file. This app only ever SELECTs against predictions/
# latest_predictions -- SportsAnalytics owns every INSERT into those.
DATABASE_URL=

# TheSportsDB (thesportsdb.com) paid API key -- provides the full NFL
# schedule (including games the model hasn't predicted yet) so the
# site can show "games to come," not just games with a prediction.
# Server-only: read via src/lib/schedule.ts, never NEXT_PUBLIC_.
THESPORTSDB_API_KEY=

# Resend (resend.com) API key -- sends the /contact page's form
# submissions to neo@matrixsports.net server-side (src/app/contact/
# actions.ts), so that address is never exposed in the page's HTML/JS
# the way a mailto: link would be. Free tier, no card required: sign
# up, grab the API key from the dashboard. Without a verified sending
# domain, Resend only allows sending TO the email the account itself
# was created with -- fine here since that's neo@matrixsports.net
# anyway; verify the matrixsports.net domain in Resend later if the
# "from" address (contact@matrixsports.net) ever needs to change or
# the form needs to send to more than one address.
RESEND_API_KEY=

# Anthropic (console.anthropic.com) API key -- powers
# netlify/functions/weekly-stories.mts, which drafts short story
# blurbs about the past week's final games, strictly from real DB
# facts (never free-recall). Server-only, read only from that Netlify
# scheduled function. Without this set, the function logs and skips
# generation -- same "ships inert until configured" pattern as
# RESEND_API_KEY/THESPORTSDB_API_KEY above. Drafts always require
# manual approval at /admin/stories before they're public -- this key
# alone can't publish anything.
ANTHROPIC_API_KEY=

# Google Identity Services client ID, for the Google One Tap prompt
# (GoogleOneTap.tsx, mounted site-wide in layout.tsx for signed-out
# visitors). Must be the SAME OAuth client ID already configured for
# the Google provider in Supabase's dashboard (Authentication >
# Providers > Google) -- otherwise the ID token's audience won't match
# what signInWithIdToken() expects. In Google Cloud Console, that
# client's "Authorized JavaScript origins" must also list this site's
# exact deployed origin (scheme + host, no path) -- One Tap's FedCM
# flow silently won't prompt on an origin Google wasn't told about, so
# this needs testing against a real deployed URL (e.g. a Netlify
# branch deploy), not localhost.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google AdSense. NEXT_PUBLIC_ADSENSE_CLIENT_ID is the site-wide
# "ca-pub-..." publisher ID (AdSense > Sites), read by
# AdSenseScript.tsx to load the ad script in <head>. The two SLOT ids
# are each a specific manual ad unit's numeric data-ad-slot value
# (AdSense > Ads > By ad unit > create ad unit), read by AdUnit.tsx:
# RAIL for the fixed 300x600 unit shown in the desktop AdFrame rails,
# MOBILE for the responsive unit shown in the inline MobileAdFrame
# slots. Each is reused across every placement of that shape on the
# site -- one ad unit per shape, not one per spot on the page. Without
# these, AdSenseScript/AdUnit render nothing -- same "ships inert"
# pattern as the other optional keys above.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=

# Google Analytics 4 measurement ID ("G-..."), read by
# GoogleAnalytics.tsx. Gated behind the visitor's cookie-consent
# choice (Consent Mode v2) -- see that file's own comment. Same
# "ships inert without it" pattern as the other optional keys here.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Ahrefs Web Analytics "data-key" (Ahrefs > Web Analytics > this
# project > Installation guide), read by AhrefsAnalytics.tsx.
# Cookieless/no personal data per Ahrefs, so unlike GA it isn't gated
# behind cookie consent. Set this ONLY in Netlify's Production scope,
# not Branch deploys -- same lesson learned the hard way with
# NEXT_PUBLIC_ADSENSE_CLIENT_ID (see netlify.toml's history): a branch
# preview reporting into the same project would count dev/testing
# traffic as if it were real visitors.
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=

# TikTok Pixel ID (TikTok Ads Manager > Assets > Events > Web Events >
# create/select a pixel > the "Pixel code" step shows this ID), read
# by TikTokPixel.tsx. Gated behind the same cookie-consent choice as
# GA (Consent Mode-equivalent via ttq.holdConsent/grantConsent/
# revokeConsent) -- see that file's own comment. Same "ships inert
# without it" pattern as the other optional keys here. Set this ONLY
# in Netlify's Production scope, not Branch deploys -- same reasoning
# as NEXT_PUBLIC_GA_MEASUREMENT_ID: a branch preview shouldn't count
# as real traffic once ad campaigns are live and reading this data.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# TikTok Developer app (developers.tiktok.com, org "Data Insight, LLC",
# app "MatrixSports.net") -- Client Key/Secret from the app's
# Credentials tab. Server-only: read by src/lib/tiktok.ts and the
# api/tiktok/* routes for the Login Kit OAuth dance and the Content
# Posting API's token refresh, never NEXT_PUBLIC_. This is the direct
# integration that replaces SocialClaw for TikTok specifically (its
# hosted asset URLs were failing TikTok's own pull step with
# photo_pull_failed -- see SportsContentCreation/tiktok_support_message.md).
# Redirect URI is hardcoded to https://matrixsports.net/api/tiktok/callback
# (see TIKTOK_REDIRECT_URI in lib/tiktok.ts) -- register that exact URI
# in the app's Login Kit product config. Set these in Netlify's
# Production scope only, same reasoning as NEXT_PUBLIC_GA_MEASUREMENT_ID:
# the OAuth redirect_uri must match exactly, and posts must only ever
# come from production, never a branch preview.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
