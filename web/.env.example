# Supabase project settings > API. The URL is derived from the same
# project as SportsWeb's DATABASE_URL (db.<ref>.supabase.co -> the API
# lives at https://<ref>.supabase.co). Use the "Publishable key" from
# the "Publishable and secret API keys" tab (starts with
# sb_publishable_) -- safe to expose to the browser. NOT the "Secret
# key" (sb_secret_..., the modern name for what used to be called
# service_role) -- that one must never leave the server.
NEXT_PUBLIC_SUPABASE_URL=https://wbhfemmudiiwlgldrzjk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection -- same value as the root SportsWeb/.env
# and SportsAnalytics/.env use, same database. Server-only: read via
# src/lib/db.ts, never NEXT_PUBLIC_, never imported from a "use client"
# file. This app only ever SELECTs against predictions/
# latest_predictions -- SportsAnalytics owns every INSERT into those.
DATABASE_URL=

# TheSportsDB (thesportsdb.com) paid API key -- provides the full NFL
# schedule (including games the model hasn't predicted yet) so the
# site can show "games to come," not just games with a prediction.
# Server-only: read via src/lib/schedule.ts, never NEXT_PUBLIC_.
THESPORTSDB_API_KEY=

# Resend (resend.com) API key -- sends the /contact page's form
# submissions to neo@matrixsports.net server-side (src/app/contact/
# actions.ts), so that address is never exposed in the page's HTML/JS
# the way a mailto: link would be. Free tier, no card required: sign
# up, grab the API key from the dashboard. Without a verified sending
# domain, Resend only allows sending TO the email the account itself
# was created with -- fine here since that's neo@matrixsports.net
# anyway; verify the matrixsports.net domain in Resend later if the
# "from" address (contact@matrixsports.net) ever needs to change or
# the form needs to send to more than one address.
RESEND_API_KEY=
